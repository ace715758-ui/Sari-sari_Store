VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# LOCAL DEV ONLY — "Scan with Phone" QR code fix
# Phones can't reach "localhost", so set this to your machine's local IP.
# Run: ipconfig (Windows) or ifconfig (Mac/Linux) to find it.
# Example: VITE_APP_URL=http://192.168.1.42:5173
# Leave this blank or remove it when deployed — the real domain is used automatically.
# VITE_APP_URL=http://192.168.1.42:5173
